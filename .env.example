# Contact form (Resend). The destination address stays server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: sender on a domain verified in Resend (defaults to onboarding@resend.dev).
CONTACT_FROM_EMAIL=
# Public URL of the portfolio, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=
# Set to 1 to accept form submissions without sending (tests).
CONTACT_DRY_RUN=
